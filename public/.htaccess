# Apache rules for Kip's front controller (shared hosting, cPanel, etc.).
# Real files are served directly; every other path goes through index.php.
# Requires mod_rewrite, which effectively all shared hosts enable.
Options -Indexes

# Static types the app writes or ships, pinned so every host labels them the
# same way whatever the vintage of its mime.types: Storage writes .webp beside
# the PNG, JPEG and GIF uploads (image/webp is absent from older Apache
# tables), and the scripts carry the one registered JavaScript type (RFC 9239).
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType text/javascript .js
</IfModule>

# Lifetimes and sniffing protection for the docroot's real files, so a CDN or
# browser sees one policy whatever the vintage of the host's defaults. `Header
# set` fires on success responses only, so app-routed 404s keep the private,
# no-store the front controller stamps. Name-stable binaries (uploads carry
# server-generated hex names, the favicon ships beside index.php) earn the
# year; the unversioned assets get the page cache's shared bound (every page
# works without them); the sitemap and robots artifacts refresh hourly.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options nosniff
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=14400"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(xml|txt)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles (.env, .git, ...), but let ACME's .well-known through
    RewriteRule (^|/)\.(?!well-known/) - [F]

    # Block private setup state by name, wherever a misupload may have put it:
    # these files live outside the web root in every supported layout.
    RewriteRule (^|/)(deployment\.php|setup-token\.txt|setup-complete\.lock|setup\.lock|setup-attempts)$ - [F]

    # OPTIONAL: serve the static page cache without PHP (shipped commented;
    # the PHP fallback in index.php is the supported path and always correct
    # on its own). Read the README's "Static page cache" section before
    # enabling: the cookie and query conditions are load-bearing, and during
    # maintenance the webserver serves cached pages without running PHP.
    # The E= flag marks a cache HIT so the Header set below applies to it.
    #RewriteCond %{REQUEST_METHOD} ^GET$ [NC]
    #RewriteCond %{QUERY_STRING} ^$
    #RewriteCond %{HTTP_COOKIE} ^$
    #RewriteCond %{DOCUMENT_ROOT}/cache%{REQUEST_URI}/index.html -f
    #RewriteRule ^ cache%{REQUEST_URI}/index.html [L,E=KIP_STATIC_HIT:1]

    # Front controller: /controller/action/args is not a real file
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# The shared-cache header for webserver-served cache files: only the optional
# block above sets KIP_STATIC_HIT, so this is inert while that block stays
# commented and fires the moment it is enabled. It mirrors the PHP send
# path's Cache-Control emission exactly, so a CDN in front of the origin
# sees one policy whichever path served the page.
<IfModule mod_headers.c>
    Header set Cache-Control "public, s-maxage=14400" env=KIP_STATIC_HIT
</IfModule>
