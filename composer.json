{
    "name": "hyperion360/kiption",
    "description": "Self-hosted fiction archive built on Kip (working title)",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "kip/framework": "^0.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Hyperion360/kip"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\Features\\": "app/Features/",
            "App\\": "app/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
