#!/usr/bin/env php
<?php // bin/kip
require __DIR__ . '/../vendor/autoload.php';
$config = require __DIR__ . '/../config.php';
\App\Lang::setCurrent($config['ui_lang'] ?? 'en'); // CLI renders too (pages:build); views render through the pack layer
\App\Features::init(new \Kip\Database($config['db']['dsn']), $config['features'] ?? []); // feature-flag resolution shares the request bootstrap

match ($argv[1] ?? 'help') {
    'migrate' => (function () use ($config) {
        $db = new Kip\Database($config['db']['dsn']);
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']), $config['log_db']['retention_days'] ?? 30);
        $log->pruneToRetention();
        $ran = (new Kip\Migrations\Migrator($db, $config['app_dir'] . '/migrations'))->migrate();
        echo $ran ? 'Ran: ' . implode(', ', $ran) . "\n" : "Nothing to migrate.\n";
    })(),
    'rollback' => (function () use ($config) { // review 4A
        $db = new Kip\Database($config['db']['dsn']);
        $undone = (new Kip\Migrations\Migrator($db, $config['app_dir'] . '/migrations'))->rollback();
        echo $undone ? 'Rolled back: ' . implode(', ', $undone) . "\n" : "Nothing to roll back.\n";
    })(),
    'serve' => (function () use ($config) {
        $ran = (new Kip\Migrations\Migrator(new Kip\Database($config['db']['dsn']), $config['app_dir'] . '/migrations'))->migrate();
        if ($ran) echo 'Auto-migrated: ' . implode(', ', $ran) . "\n";
        passthru('KIP_ENV=dev php -S localhost:8080 -t ' . escapeshellarg(__DIR__ . '/../public'));
    })(),
    'user:create' => (function () use ($config, $argv) {
        $rest    = array_slice($argv, 2);
        $isAdmin = in_array('--admin', $rest, true);
        $rest    = array_values(array_filter($rest, static fn(string $a): bool => $a !== '--admin'));
        $email    = $rest[0] ?? '';
        $password = $rest[1] ?? null;
        if ($email === '') {
            fwrite(STDERR, "Usage: kip user:create <email> [password] [--admin]\n");
            exit(1);
        }
        if ($password === null) {                       // QA T8: keep secrets out of shell history / ps
            fwrite(STDOUT, "Password (input hidden): ");
            if (function_exists('shell_exec') && stripos(PHP_OS_FAMILY, 'Windows') === false) {
                shell_exec('stty -echo 2>/dev/null');
                $password = rtrim((string) fgets(STDIN), "\n");
                shell_exec('stty echo 2>/dev/null');
                fwrite(STDOUT, "\n");
            } else {
                $password = rtrim((string) fgets(STDIN), "\n"); // visible fallback (Windows / no stty)
            }
        }
        if (strlen($password) < 8) {
            fwrite(STDERR, "Password must be at least 8 characters (matches the reset flow).\n");
            exit(1);
        }
        $db = new Kip\Database($config['db']['dsn']);
        $store = [];
        $auth = new Kip\Auth($db, new Kip\Session($store));
        try {
            $auth->register($email, $password);
        } catch (\PDOException $e) {
            if (str_contains($e->getMessage(), 'UNIQUE')) {
                fwrite(STDERR, "A user with email {$email} already exists.\n");
                exit(1);
            }
            throw $e;
        }
        // Phase-5 login gates: an admin-created account is trusted by construction,
        // so it is born verified and approved (no email token exists for it).
        $db->query('UPDATE users SET email_verified_at = COALESCE(email_verified_at, ?),
                    approved_at = COALESCE(approved_at, ?) WHERE email = ?', [date('c'), date('c'), $email]);
        if ($isAdmin) {
            try {
                $db->query('UPDATE users SET is_admin = 1, role = \'admin\' WHERE email = ?', [$email]);
            } catch (\PDOException) {
                fwrite(STDERR, "User created, but users.is_admin is missing, run the add_users_is_admin migration first.\n");
                exit(1);
            }
        }
        echo "User {$email} created" . ($isAdmin ? ' (admin)' : '') . ".\n";
    })(),
    'logs' => (function () use ($config) {
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']), $config['log_db']['retention_days'] ?? 30);
        $log->pruneToRetention();
        foreach (array_reverse($log->recent(50)) as $r) {
            $user = $r['user_id'] !== null ? "user:{$r['user_id']}" : 'guest';
            printf("%s %3d %-6s %-40s %6.1fms %-15s %s\n", $r['created_at'], $r['status'], $r['method'], $r['path'], $r['duration_ms'], $r['ip'], $user);
        }
    })(),
    'logs:prune' => (function () use ($config, $argv) {
        $arg = $argv[2] ?? '--days=30';
        if (!preg_match('/^--days=(\d+)$/', $arg, $m) || (int) $m[1] < 1) {
            fwrite(STDERR, "Usage: kip logs:prune --days=<positive integer>\n");
            exit(1);
        }
        $days = (int) $m[1];
        $log = new Kip\RequestLog(new Kip\Database($config['log_db']['dsn']));
        printf("Pruned %d rows older than %d days.\n", $log->prune($days), $days);
        // The page_stats day prune rides the SAME --days (finding 9: this arm
        // otherwise only ever opens the log db; a fixed window would drift from
        // the operator's retention choice). Day-keyed rows, one DELETE.
        (new Kip\Database($config['db']['dsn']))
            ->query("DELETE FROM page_stats WHERE day < date('now', '-' || ? || ' days')", [$days]);
    })(),
    'backup' => (function () use ($config) {
        $result = (new Kip\Backup(array_filter([
            'data'  => $config['db']['dsn'] ?? null,
            'logs'  => $config['log_db']['dsn'] ?? null,
            'cache' => $config['cache_db']['dsn'] ?? null,
        ]), $config['backups']['dir'] ?? $config['app_dir'] . '/backups',
            (int) ($config['backups']['keep_days'] ?? 14)))->run(date('Ymd-His'));
        echo "Backup written: {$result}\n";
    })(),
    'db:seed' => (function () use ($config, $argv) {
        $db = new Kip\Database($config['db']['dsn']);
        try {
            \App\Seeder::run($db, force: in_array('--force', $argv, true));
        } catch (\RuntimeException $e) {
            fwrite(STDERR, $e->getMessage() . "\n");
            exit(1);
        }
        if ($config['static_cache']['enabled'] ?? false) {
            \App\StaticCache\Builder::prune($config['static_cache']['dir'], $config['app_dir']);
            echo "Static page cache and framework page cache purged.\n";
        }
        echo "Seeded demo archive (2 stories, 4 chapters, ratings ladder, one category).\n";
    })(),
    'pages:build' => (function () use ($config) {
        $dir = $config['static_cache']['dir'] ?? null;
        if ($dir === null) { fwrite(STDERR, "static_cache not configured.\n"); exit(1); }
        $n = \App\StaticCache\Builder::build($config, $dir);
        echo "Built {$n} static pages into {$dir}.\n";
    })(),
    'pages:prune' => (function () use ($config) {
        $dir = $config['static_cache']['dir'] ?? null;
        if ($dir === null) { fwrite(STDERR, "static_cache not configured.\n"); exit(1); }
        \App\StaticCache\Builder::prune($dir, $config['app_dir']);
        echo "Static layer and framework page cache pruned.\n";
    })(),
    'robots' => (function () use ($config) {
        $file = ($config['public_dir'] ?? dirname(__DIR__) . '/public') . '/robots.txt';
        \App\Seo\Sitemap::writeRobots($file, (bool) ($config['ai_crawlers'] ?? true));
        echo "Wrote {$file}\n";
    })(),
    'digest:send' => (function () use ($config, $argv) {
        // The flag gate precedes ANY work (the guard-before-data rule, CLI
        // arm): off means no member query, no mailer, no send. Immediate
        // story-update emails ride Notifications and stay untouched.
        if (!\App\Features::on('digest')) {
            echo "digest feature is disabled\n";
            return;
        }
        $mailLog = '';
        foreach (array_slice($argv, 2) as $a) { if (str_starts_with($a, '--mail-log=')) { $mailLog = substr($a, 11); } }
        $mail = $config['mail'] ?? [];
        if ($mailLog !== '') { // operator-visible test seam (the mail:users idiom)
            $mail['transport'] = 'log';
            $mail['log_path'] = $mailLog;
        }
        $db = new Kip\Database($config['db']['dsn']);
        $mailer = new Kip\Mailer($mail);
        $digest = new \App\Digest($db, $mailer, rtrim((string) ($config['base_url'] ?? ''), '/'));
        printf("Digest mailed to %d members.\n", $digest->send());
    })(),
    'release:due' => (function () use ($config, $argv) {
        // The digest:send idiom: the flag gate precedes ANY work. The flag
        // gates this ARM, never the authoring input (the README row): a
        // scheduled chapter keeps storing while it is off, it just never
        // auto-releases.
        if (!\App\Features::on('releases')) {
            echo "releases feature is disabled\n";
            return;
        }
        $mailLog = '';
        foreach (array_slice($argv, 2) as $a) { if (str_starts_with($a, '--mail-log=')) { $mailLog = substr($a, 11); } }
        $mail = $config['mail'] ?? [];
        if ($mailLog !== '') { // operator-visible test seam (the digest idiom)
            $mail['transport'] = 'log';
            $mail['log_path'] = $mailLog;
        }
        $db = new Kip\Database($config['db']['dsn']);
        $released = (new \App\Repositories\AuthoringRepository($db))->releaseDue();
        printf("Released %d chapter(s).\n", count($released));
        // Per row, the queue approve's full set: the story purge with the lists
        // and challenge riders (QueueController::purge's shape) plus the
        // publish fan-out.
        $cache = new \App\StaticCache\Cache((string) (($config['static_cache'] ?? [])['dir'] ?? dirname(__DIR__) . '/public/cache'));
        $fanout = new \App\PublishFanout($db, new Kip\Mailer($mail), rtrim((string) ($config['base_url'] ?? ''), '/'));
        foreach ($released as [$slug, $cats, $seriesSlugs, $authorSlug, $challengeSlugs, $storyId]) {
            $listSlugs = (new \App\Repositories\ListsRepository($db))->publicListSlugsForStory($storyId);
            $cache->purgeStory($slug, $cats, $seriesSlugs, $authorSlug, $listSlugs, $challengeSlugs);
            $fanout->publish($slug);
        }
    })(),
    'import:token' => (function () use ($argv) {
        $token = bin2hex(random_bytes(32));
        $hash = hash('sha256', $token);
        echo "1. Create a file named export-token.php next to efiction-export.php on the OLD install,\n";
        echo "   containing exactly this one line (no leading space, no newline before <?php):\n";
        echo "   <?php return '{$hash}';\n";
        echo "2. Open efiction-export.php in the browser and paste this token:\n";
        echo "   token: {$token}\n";
        echo "3. Treat the downloaded bundle as a password file: it contains member email addresses\n";
        echo "   and legacy password hashes. Delete export-token.php and efiction-export.php when done\n";
        echo "   (the exporter page has a self-delete button that removes both).\n";
    })(),
    'import:efiction' => (function () use ($config, $argv) {
        $bundle = $argv[2] ?? '';
        $mode = in_array('--dry-run', $argv, true) ? 'dry-run' : (in_array('--commit', $argv, true) ? 'commit' : '');
        $encoding = 'auto';
        foreach ($argv as $i => $a) { if ($i > 2 && str_starts_with($a, '--encoding=')) { $encoding = substr($a, 11); } }
        if ($bundle === '' || !is_file($bundle) || $mode === '') {
            fwrite(STDERR, "Usage: kip import:efiction <bundle.tar.gz> (--dry-run|--commit) [--encoding=auto|latin1|utf8] [--allow-missing-text]\n");
            exit(1);
        }
        try {
            $db = new Kip\Database($config['db']['dsn']);
            $reader = new \App\Import\BundleReader($bundle);
            echo (new \App\Import\Importer($db, $reader, $mode, $encoding, in_array('--allow-missing-text', $argv, true), $config))->run();
        } catch (\RuntimeException $e) {
            // operator-facing failures print clean and exit 1, no stack trace
            fwrite(STDERR, $e->getMessage() . "\n");
            exit(1);
        }
    })(),
    'mail:users' => (function () use ($config, $argv) {
        $rest = array_slice($argv, 2);
        $mode = in_array('--dry-run', $rest, true) ? 'dry-run' : (in_array('--commit', $rest, true) ? 'commit' : '');
        $template = $mailLog = '';
        $positional = [];
        foreach ($rest as $a) {
            if (str_starts_with($a, '--template=')) { $template = substr($a, 11); }
            elseif (str_starts_with($a, '--mail-log=')) { $mailLog = substr($a, 11); }
            elseif (!str_starts_with($a, '--')) { $positional[] = $a; }
        }
        $subject = $positional[0] ?? '';
        $body = $positional[1] ?? '';
        if ($mode === '' || $subject === '' || $body === '') {
            fwrite(STDERR, "Usage: kip mail:users <subject> <body> (--dry-run|--commit) [--template=<name>] [--mail-log=<path>]\n");
            fwrite(STDERR, "  --template=<name> wins over the literal pair when the name exists; a missing name falls back to the literals.\n");
            exit(1);
        }
        $db = new Kip\Database($config['db']['dsn']);
        if ($template !== '') {
            // Reads what exists; seedDefaults is the admin editor's job, never the CLI's.
            [$s, $b] = \App\Templates::get($db, $template, '', '');
            if ($s === '' && $b === '') {
                echo "Template '{$template}' not found, using the literal subject/body.\n";
            } else {
                $subject = $s;
                $body = $b;
            }
        }
        // Eligibility is the member directory gate (UserRepository::authorsDirectory):
        // approved + verified + unlocked members with a penname.
        $recipients = array_column($db->all(
            'SELECT email FROM users WHERE penname IS NOT NULL AND is_locked = 0
             AND approved_at IS NOT NULL AND email_verified_at IS NOT NULL ORDER BY id'), 'email');
        if ($mode === 'dry-run') {
            $first = array_slice($recipients, 0, 5);
            echo 'would mail ' . count($recipients) . ' recipient(s)'
                . ($first === [] ? '' : ': ' . implode(', ', $first)) . "\n";
            return;
        }
        $mail = $config['mail'] ?? [];
        if ($mailLog !== '') { // operator-visible test seam: override the transport to log at the given path
            $mail['transport'] = 'log';
            $mail['log_path'] = $mailLog;
        }
        $mailer = new Kip\Mailer($mail);
        $mailed = 0;
        foreach ($recipients as $email) {
            try { // the Digest idiom: one bad address never stops the batch
                $mailer->send($email, $subject, $body);
                $mailed++;
            } catch (\Throwable $e) {
                error_log("mail:users failed for {$email}: " . $e->getMessage());
            }
        }
        echo "mailed {$mailed}\n";
    })(),
    default => print("Usage: kip [migrate|rollback|serve|logs|logs:prune|backup|pages:build|pages:prune|robots|digest:send|release:due [--mail-log=<path>]|import:token|import:efiction <bundle.tar.gz> (--dry-run|--commit)|mail:users <subject> <body> (--dry-run|--commit) [--template=<name>] [--mail-log=<path>]|db:seed [--force]|user:create <email> [password] [--admin]]\n"),
};
